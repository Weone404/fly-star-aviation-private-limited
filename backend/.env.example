# Local development only. Copy to .env and replace placeholders before use.
# Never use Production credentials or a Production database in this file.
NODE_ENV=development
PORT=5000
MONGODB_URI=replace-with-local-development-mongodb-uri

# Required for local admin authentication; use local-only values.
ADMIN_USERNAME=replace-with-local-admin-username
ADMIN_PASSWORD=replace-with-local-password-at-least-16-bytes
ADMIN_SESSION_SECRET=replace-with-random-local-secret-at-least-32-bytes

# Optional; required only for image uploads.
CLOUDINARY_CLOUD_NAME=replace-with-local-cloud-name
CLOUDINARY_API_KEY=replace-with-local-api-key
CLOUDINARY_API_SECRET=replace-with-local-api-secret
